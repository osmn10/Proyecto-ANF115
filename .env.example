# --- Desarrollo local (copia este archivo como .env) ---
DEBUG=True
SECRET_KEY=tu-clave-secreta-aqui
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos: si no se define DATABASE_URL se usa SQLite (db.sqlite3).
# Ejemplo de PostgreSQL: DATABASE_URL=postgres://usuario:clave@localhost:5432/mi_base

# --- Solo en el servidor (Render): se configuran en el panel, NO en este archivo ---
# RENDER=true                  (Render la define sola)
# RENDER_EXTERNAL_HOSTNAME=... (Render la define sola)
# DATABASE_URL=...             (URL interna de la base de datos de Render)
# SECRET_KEY=...               (clave larga y aleatoria)
# DEBUG=False
# ADMIN_USERNAME=...           (administrador inicial, lo crea crear_admin_inicial)
# ADMIN_PASSWORD=...
# ADMIN_EMAIL=...              (opcional)